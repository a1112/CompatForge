[Unit]
Description=CompatForge per-user Windows application service
PartOf=graphical-session.target
After=graphical-session-pre.target

[Service]
Type=simple
ExecStart=/usr/bin/compatforge-cli service-daemon %h/.config/compatforge/context.json %h/.config/compatforge/service.json
ExecStop=/usr/bin/compatforge-cli service-stop
TimeoutStopSec=120
KillMode=control-group
UMask=0077
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
