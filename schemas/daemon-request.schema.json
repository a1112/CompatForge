{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compatforge.dev/schemas/daemon-request.schema.json",
  "title": "CompatForge Private Linux Daemon Request",
  "oneOf": [
    {
      "$ref": "service-request.schema.json"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "requestId",
        "operation",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "const": "1"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "operation": {
          "const": "daemon.stop"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false
        }
      }
    }
  ]
}
