{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compatforge.dev/schemas/linux-provider.schema.json",
  "title": "CompatForge Linux Provider Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runtimeStoreRoot", "wineRuntime"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "runtimeStoreRoot": {"$ref": "#/$defs/absoluteLinuxPath"},
    "wineRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "providerId",
        "packId",
        "packDigest",
        "version",
        "architecture",
        "materializedRoot",
        "wine",
        "wineserver",
        "capabilities",
        "wined3dCapabilities"
      ],
      "properties": {
        "providerId": {"$ref": "#/$defs/id"},
        "packId": {"$ref": "#/$defs/id"},
        "packDigest": {"$ref": "#/$defs/digest"},
        "version": {"$ref": "#/$defs/version"},
        "architecture": {"const": "x86_64"},
        "materializedRoot": {"$ref": "#/$defs/absoluteLinuxPath"},
        "wine": {"$ref": "#/$defs/entrypoint"},
        "wineserver": {"$ref": "#/$defs/entrypoint"},
        "capabilities": {"const": ["guest-x86_64"]},
        "wined3dCapabilities": {"const": ["opengl"]}
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[0-9][0-9A-Za-z._+-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "absoluteLinuxPath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4096,
      "pattern": "^/(?!\\.\\.?(?:/|$))(?![\\s\\S]*(?:/\\.\\.?)(?:/|$))(?![\\s\\S]*//)(?![\\s\\S]*\\\\)(?![\\s\\S]*[\\u0000\\r\\n])[^/]+(?:/[^/]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![\\s\\S]*(?:^|/)\\.\\.?(?:/|$))(?![\\s\\S]*[\\\\:])(?![\\s\\S]*[\\u0000\\r\\n])[^/]+(?:/[^/]+)*$"
    },
    "entrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
