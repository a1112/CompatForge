{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compatforge.dev/schemas/install-request.schema.json",
  "title": "CompatForge Prepared Install Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "bottleId", "package", "handler", "constraints"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "requestId": { "type": "string", "format": "uuid" },
    "bottleId": { "$ref": "#/$defs/id" },
    "recipeId": { "$ref": "#/$defs/id" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fileName", "sha256", "sizeBytes", "mediaType"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096, "not": {"pattern": "[\u0000-\u001f\u007f-\u009f]"} },
        "fileName": { "type": "string", "maxLength": 255, "pattern": "^[A-Za-z0-9_][A-Za-z0-9 ._()+-]{0,250}\\.[mM][sS][iI]$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 2147483648 },
        "mediaType": { "const": "application/x-msi" }
      }
    },
    "handler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "action", "ui", "reboot", "properties"],
      "properties": {
        "kind": { "const": "msiexec" },
        "action": { "const": "install" },
        "ui": { "enum": ["none", "basic"] },
        "reboot": { "const": "suppress" },
        "properties": {
          "type": "object",
          "maxProperties": 5,
          "additionalProperties": false,
          "properties": {
            "ALLUSERS": {"enum": ["1", "2"]},
            "MSIINSTALLPERUSER": {"const": "1"},
            "INSTALLDIR": {"$ref": "#/$defs/installDirectory"},
            "INSTALLFOLDER": {"$ref": "#/$defs/installDirectory"},
            "TARGETDIR": {"$ref": "#/$defs/installDirectory"}
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowVirtualMachine", "allowRemote", "networkPolicy", "maximumRuntimeMilliseconds"],
      "properties": {
        "allowVirtualMachine": { "const": false },
        "allowRemote": { "const": false },
        "networkPolicy": { "enum": ["deny", "installer-only"] },
        "maximumRuntimeMilliseconds": { "type": "integer", "minimum": 1000, "maximum": 3600000 }
      }
    }
  },
  "$defs": {
    "installDirectory": {"type": "string", "minLength": 4, "maxLength": 4096, "pattern": "^C:\\\\[^\"<>|?*/=:]+$", "not": {"pattern": "[^\\u0021-\\u007e]|(^|\\\\)\\.{1,2}(\\\\|$)|\\\\\\\\|[. ](\\\\|$)|\\\\$"}},
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
