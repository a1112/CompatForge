{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compatforge.dev/schemas/install-request.schema.json",
  "title": "CompatForge Prepared Install Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "bottleId", "package", "handler", "constraints"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "requestId": { "type": "string", "format": "uuid" },
    "bottleId": { "$ref": "#/$defs/id" },
    "recipeId": { "$ref": "#/$defs/id" },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fileName", "sha256", "sizeBytes", "mediaType"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "fileName": { "type": "string", "pattern": "^[^/\\\\]{1,251}\\.[mM][sS][iI]$" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "mediaType": { "const": "application/x-msi" }
      }
    },
    "handler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "action", "ui", "reboot", "properties"],
      "properties": {
        "kind": { "const": "msiexec" },
        "action": { "const": "install" },
        "ui": { "enum": ["none", "basic"] },
        "reboot": { "const": "suppress" },
        "properties": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
          "additionalProperties": { "type": "string", "maxLength": 4096 }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowVirtualMachine", "allowRemote", "networkPolicy", "maximumRuntimeMilliseconds"],
      "properties": {
        "allowVirtualMachine": { "const": false },
        "allowRemote": { "const": false },
        "networkPolicy": { "enum": ["deny", "installer-only"] },
        "maximumRuntimeMilliseconds": { "type": "integer", "minimum": 1000, "maximum": 3600000 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
