{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compatforge.dev/schemas/capability-probe-result.schema.json",
  "title": "CompatForge Capability Probe Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "runId", "probeId", "probeManifestDigest", "artifactDigest", "testSuiteVersion", "host", "runtimePackDigest", "translator", "graphicsBackend", "guestArchitecture", "outcome", "startedAt", "finishedAt", "observations", "checks", "artifacts"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "runId": { "type": "string", "format": "uuid" },
    "probeId": { "$ref": "#/$defs/id" },
    "probeManifestDigest": { "$ref": "#/$defs/prefixedSha256" },
    "artifactDigest": { "$ref": "#/$defs/prefixedSha256" },
    "testSuiteVersion": { "$ref": "#/$defs/id" },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "version", "architecture", "displayProtocol"],
      "properties": {
        "os": { "enum": ["macos", "linux"] },
        "version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "architecture": { "enum": ["x86_64", "arm64"] },
        "displayProtocol": { "enum": ["appkit", "x11", "wayland", "headless"] },
        "gpu": { "type": "string", "minLength": 1, "maxLength": 256 },
        "driver": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "runtimePackDigest": { "$ref": "#/$defs/prefixedSha256" },
    "translator": { "enum": ["native", "rosetta", "fex", "box64", "qemu"] },
    "graphicsBackend": { "enum": ["none", "wined3d", "dxvk", "vkd3d-proton", "d3dmetal", "moltenvk"] },
    "guestArchitecture": { "enum": ["i386", "x86_64"] },
    "outcome": { "enum": ["passed", "failed", "blocked", "unsupported"] },
    "failureClassification": { "$ref": "#/$defs/failureClassification" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "observations": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "type": ["string", "number", "boolean"] },
      "maxProperties": 64
    },
    "checks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "outcome"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "outcome": { "enum": ["passed", "failed", "blocked", "skipped"] },
          "message": { "type": "string", "maxLength": 4096 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "sizeBytes"],
        "properties": {
          "name": { "$ref": "#/$defs/fileName" },
          "sha256": { "$ref": "#/$defs/prefixedSha256" },
          "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "passed" } }, "required": ["outcome"] },
      "then": { "not": { "required": ["failureClassification"] } },
      "else": { "required": ["failureClassification"] }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$" },
    "prefixedSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "fileName": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\]+$" },
    "failureClassification": { "enum": ["unsupported", "runtime-regression", "recipe-regression", "host-driver", "translator", "graphics", "policy-blocked", "test-infrastructure"] }
  }
}
