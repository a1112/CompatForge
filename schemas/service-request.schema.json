{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compatforge.dev/schemas/service-request.schema.json",
  "title": "CompatForge Headless Service Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "operation",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "operation": {
      "enum": [
        "applications.seed-defaults",
        "applications.list",
        "applications.get",
        "applications.upsert",
        "applications.remove",
        "bottles.list",
        "bottles.get",
        "bottles.create",
        "bottles.archive",
        "bottles.archives.list",
        "bottles.restore",
        "settings.get",
        "settings.update",
        "jobs.submit",
        "jobs.list",
        "jobs.get",
        "jobs.poll",
        "jobs.cancel",
        "jobs.assess",
        "applications.generations",
        "applications.rollback",
        "applications.uninstall",
        "applications.recover",
        "desktop.launchers",
        "debug.session",
        "debug.dap"
      ]
    },
    "payload": {}
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "debug.session" } } },
      "then": { "properties": { "payload": { "$ref": "debug-session-request.schema.json" } } }
    },
    {
      "if": { "properties": { "operation": { "const": "debug.dap" } } },
      "then": { "properties": { "payload": { "$ref": "debug-dap-request.schema.json" } } }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "applications.generations",
              "applications.uninstall",
              "applications.recover"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "application.schema.json#/$defs/id"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "applications.rollback"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "applicationId",
              "generationId"
            ],
            "properties": {
              "applicationId": {
                "$ref": "application.schema.json#/$defs/id"
              },
              "generationId": {
                "$ref": "application.schema.json#/$defs/id"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "jobs.submit"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "job.schema.json#/$defs/request"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "desktop.launchers"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
