{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compatforge.dev/schemas/context-config.schema.json",
  "title": "CompatForge Core Context Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capabilities", "runtimeBindings", "storageRoot"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "capabilities": { "$ref": "capability-report.schema.json" },
    "runtimeBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["providerId", "packId", "packDigest", "executable"],
        "properties": {
          "providerId": { "$ref": "#/$defs/id" },
          "packId": { "$ref": "#/$defs/id" },
          "packDigest": { "$ref": "#/$defs/digest" },
          "executable": { "type": "string", "minLength": 1 },
          "wineserverExecutable": { "type": "string", "minLength": 1 },
          "environment": {
            "type": "object",
            "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "additionalProperties": { "type": "string" }
          },
          "workingDirectory": { "type": "string", "minLength": 1 }
        }
      }
    },
    "wineInstallerTools": {"type": "array", "items": {"$ref": "runtime-installer-tool.schema.json"}},
    "storageRoot": { "type": "string", "minLength": 1 },
    "sandboxProfile": {
      "enum": ["strict", "desktop", "game", "developer", "unconfined"]
    },
    "supervisor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminationGraceMilliseconds"],
      "properties": {
        "terminationGraceMilliseconds": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "maximumRuntimeMilliseconds": { "type": "integer", "minimum": 1, "maximum": 604800000 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" }
  }
}
