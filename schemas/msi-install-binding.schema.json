{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compatforge.dev/schemas/msi-install-binding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["package", "handler", "tool", "maximumRuntimeMilliseconds"],
  "properties": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "storedPath", "architecture"],
      "properties": {
        "package": {"$ref": "install-request.schema.json#/properties/package"},
        "storedPath": {"type": "string", "minLength": 1, "not": {"pattern": "[\u0000-\u001f\u007f-\u009f]"}},
        "architecture": {"enum": ["i386", "x86_64"]}
      }
    },
    "handler": {"$ref": "install-request.schema.json#/properties/handler"},
    "tool": {"$ref": "runtime-installer-tool.schema.json"},
    "maximumRuntimeMilliseconds": {"type": "integer", "minimum": 1000, "maximum": 3600000}
  }
}
