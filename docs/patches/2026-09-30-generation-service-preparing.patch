+        std::fs::remove_dir(&job_path).unwrap();
+        let deadline = std::time::Instant::now() + Duration::from_secs(1);
+        loop {
+            let result = manager.poll("cleanup-job", 10).unwrap();
+            if result.stream_ended {
+                assert_eq!(result.job.status, JobStatus::Failed);
